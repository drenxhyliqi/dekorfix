# Copy to `.env` and adjust:  cp .env.example .env
# `.env` is git-ignored. Never commit real credentials.

# development | test | production
ENVIRONMENT=development

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=dekorfix
POSTGRES_USER=dekorfix
POSTGRES_PASSWORD=change-me
# Host/port as seen from your machine (used when running the API outside Docker).
# 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Optional. When set, overrides the POSTGRES_* values above for the API,
# e.g. postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# --- API (FastAPI) -----------------------------------------------------------
API_PORT=8000
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Web (Next.js) -----------------------------------------------------------
WEB_PORT=3000
# Public origin of the website (canonical and Open Graph URLs).
SITE_URL=http://localhost:3000
# Public: inlined into the browser bundle. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Admin -------------------------------------------------------------------
# /admin has no login yet: it is open in development and returns 404 in
# production builds unless this is "true". Remove once admin auth exists.
ADMIN_PREVIEW=false
